# ── Odoo Staging Environment ───────────────────────────────────────
# Copy this file to .env and replace passwords before deploying.
#
# In Coolify, set these as Environment Variables in the service UI:
#   Key=Value pairs, same as below.

ODOO_VERSION=19.0

# ── PostgreSQL credentials ─────────────────────────────────────────
# These must match between db and odoo services.
# The compose cascade resolves both DB_* and POSTGRES_* names.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=GIeoW6kk0J2TkFtlG1e4OO3O5Qk_dRxx
POSTGRES_DB=postgres
DB_USER=odoo
DB_PASSWORD=GIeoW6kk0J2TkFtlG1e4OO3O5Qk_dRxx

# ── Odoo (override only if needed, defaults are fine) ──────────────
# DB_HOST=db
# DB_PORT=5432

# ── Modules to install on first database init ──────────────────────
# Comma-separated list of modules. Extra-addons in /mnt/extra-addons
# are auto-detected and installed automatically.
DEFAULT_MODULES=
